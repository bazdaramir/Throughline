#!/bin/sh
# tl-brief - Throughline SessionStart context brief (W7)
#
# DETERMINISTIC. NO MODEL CALL. Uses only git, awk and shell builtins.
# The brief is assembled by path matching, which means it is instant, free, and
# structurally incapable of inventing a decision the user never wrote.
#
# HARD RULES:
#   - Never block session start. Every path exits 0.
#   - Never exceed the output budget (~400 tokens).
#   - Never include a note tagged #tl/draft. A draft may be COUNTED - "2 unreviewed
#     drafts touch these files" - but no title, id or word of it is ever printed.
#   - Never include a Session note body - only open_threads, bounded and labelled
#     as unreviewed (it is written by a model and no human has read it).
#   - Only status: active Decisions and status: open Gotchas.
#
# WHAT COUNTS AS A DRAFT is decided the way Obsidian decides it, so that the
# Needs Review queue and this brief can never disagree: tl/draft in frontmatter
# tags in any YAML shape, or #tl/draft inline in the body outside code. When in
# doubt a note is treated as a draft - leaving a real note out of the brief is
# visible in the queue, while letting a draft in is invisible.
#
# FRONTMATTER SHAPES: Obsidian's Properties panel rewrites every list it touches
# as a block list, including on the edit that promotes a draft. Flow lists
# (key: ["a", "b"]), block lists, quoted and bare items, CRLF line endings and a
# byte-order mark are all read identically. A parser that only knows one shape
# drops promoted notes out of retrieval without a sound.
#
# PERFORMANCE: the <2s budget is a hard limit and process spawns dominate the
# cost, so frontmatter is extracted in bulk - one awk pass per note type, and that
# same pass yields the draft counts. A first version used a separate pass and
# split the rows with sed and grep: about fifteen extra processes, and +60% on a
# vault of 800 notes under Git Bash, where a process costs more than reading a note.
# Rows are split in shell now. Do not reintroduce either, or per-file grep/sed loops.

set -u

BUDGET_CHARS=1500       # ~400 tokens at a conservative ~3.75 chars/token
S='@@'                  # field separator; cannot occur in a note title or path
BOM=$(printf '\357\273\277')  # UTF-8 byte-order mark, as Windows PowerShell 5.1 writes it

# ---------------------------------------------------------------- guards ---
# Any failure here means "say nothing", never "fail loudly".

# The SessionEnd distiller is a headless Claude Code session; a brief in its
# context is noise about someone else's work.
[ -n "${THROUGHLINE_DISTILLING:-}" ] && exit 0

[ -f ./.throughline ] || exit 0

# One key from .throughline. Hand edits add quotes and trailing blanks; neither
# is part of a slug or a path, and either one used to fail silently.
tlconf() {
  sed -n "s/^$1:[[:space:]]*//p" ./.throughline 2>/dev/null | head -1 | tr -d '\r' \
    | sed -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'\$/\1/"
}

proj=$(tlconf project)
[ -n "$proj" ] || exit 0

vault="${THROUGHLINE_VAULT:-}"
[ -n "$vault" ] || vault=$(tlconf vault)
[ -n "$vault" ] || vault="$HOME/Throughline"
case "$vault" in
  '~/'*) vault="$HOME/${vault#\~/}" ;;
  '~')   vault="$HOME" ;;
esac

[ -d "$vault/00 Command" ] || exit 0
pdir="$vault/01 Projects/$proj"
[ -d "$pdir/Components" ] || exit 0

command -v git >/dev/null 2>&1 || exit 0
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0

# ------------------------------------------------------- the changed set ---
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')
changed=$(
  {
    git -c core.quotepath=off status --porcelain 2>/dev/null | cut -c4-
    git -c core.quotepath=off diff --name-only HEAD~3 2>/dev/null \
      || git -c core.quotepath=off diff --name-only HEAD 2>/dev/null
  } | sed 's/^"//; s/"$//' | grep -v '^$' | sort -u
)
[ -n "$changed" ] || exit 0

# --------------------------------------------------- bulk frontmatter awk ---
# Shared prologue: reads the frontmatter block (which must open on line 1, as
# in Obsidian), decides the tl/draft quarantine, and collects the fields each
# note type needs. List values accumulate in val[], joined by SEP.
AWK_FM='
BEGIN { LIST["paths"] = LIST["affects"] = LIST["open_threads"] = LIST["tags"] = LIST["tag"] = 1 }
function base(p,   n, a) { n = split(p, a, "/"); p = a[n]; sub(/\.md$/, "", p); return p }
function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
function unquote(s,   c) {
  s = trim(s); c = substr(s, 1, 1)
  if (length(s) >= 2 && (c == "\"" || c == Q) && substr(s, length(s), 1) == c)
    s = substr(s, 2, length(s) - 2)
  return s
}
function add(k, v) {
  v = unquote(v)
  if (k == "affects") {            # a link: keep only the target note name
    sub(/^\[+/, "", v); sub(/\]+$/, "", v); sub(/[|#].*$/, "", v)
    v = base(trim(v))
  } else if (k == "paths") {       # repo-relative, as git reports them
    sub(/^\.\//, "", v); sub(/^\//, "", v)
  }
  if (v != "") val[k] = (val[k] == "") ? v : val[k] SEP v
}
function flowlist(k, s,   i, c, q, item) {
  s = trim(s); sub(/^\[/, "", s); sub(/\][ \t]*$/, "", s)
  q = ""; item = ""
  for (i = 1; i <= length(s); i++) {
    c = substr(s, i, 1)
    if (q != "")                                        { if (c == q) q = "" }
    else if ((c == "\"" || c == Q) && trim(item) == "") { q = c }
    else if (c == ",")                                  { add(k, item); item = ""; continue }
    item = item c
  }
  add(k, item)
}
function scalar(k, v) {
  sub(/[ \t]+#.*$/, "", v); v = unquote(v)
  if (k == "status") status = v; else if (k == "reversal_cost") rc = v
  else if (k == "severity") sev = v; else if (k == "branch") br = v
  else if (k == "cost") cost = v
}
function drafted(   n, a, i) {
  n = split(val["tags"] SEP val["tag"], a, SEP)
  for (i = 1; i <= n; i++)
    if (a[i] ~ /^#?tl\/draft(\/|[^A-Za-z0-9_-]|$)/ || a[i] ~ /[^A-Za-z0-9_\/-]#?tl\/draft(\/|[^A-Za-z0-9_-]|$)/)
      draft = 1
  return draft
}
FNR == 1 {
  flush()
  f = FILENAME; draft = 0; infm = 0; fence = 0; key = ""; inflow = 0
  status = ""; rc = ""; cost = ""; sev = ""; br = ""
  split("", val)
}
{ sub(/\r$/, "") }
FNR == 1 && index($0, BOM) == 1 { $0 = substr($0, length(BOM) + 1) }
FNR == 1 && /^---[ \t]*$/ { infm = 1; next }
infm && /^---[ \t]*$/     { infm = 0; next }
infm {
  if ($0 ~ /^[A-Za-z_][A-Za-z0-9_-]*:/) {
    key = $0; sub(/:.*/, "", key); inflow = 0
    value = $0; sub(/^[^:]*:/, "", value); value = trim(value)
    if (value == "") next                               # a block list may follow
    if (!(key in LIST)) scalar(key, value)
    else if (substr(value, 1, 1) != "[") add(key, value)
    else { flowlist(key, value); inflow = (value !~ /\][ \t]*$/) }
  } else if (inflow) {                                  # a flow list split across lines
    flowlist(key, $0); if ($0 ~ /\][ \t]*$/) inflow = 0
  } else if (key in LIST && $0 ~ /^[ \t]*-([ \t]|$)/) {
    value = $0; sub(/^[ \t]*-[ \t]*/, "", value); add(key, value)
  }
  next
}
/^[ \t]*(```|~~~)/ { fence = !fence; next }
!fence {
  line = $0; gsub(/`[^`]*`/, "", line)
  if (line ~ /(^|[^A-Za-z0-9_\/&-])#tl\/draft(\/|[^A-Za-z0-9_-]|$)/) draft = 1
}
'

# --------------------------------------- changed paths -> Components -------
# Every pass reads every note once and emits one row per note of exactly one KIND:
#   P  a promoted note - the only kind that can ever reach the brief
#   D  a draft         - used for COUNTS only; no title, id or text of it is ever printed
# The kind is decided by drafted() in the same function that builds the row, and the
# shell loops below branch on it with a `case`, so a draft cannot be mistaken for a
# promoted note downstream. Reading the drafts in the same pass - and splitting the
# rows in shell, not with sed or grep - is what keeps the brief inside its time
# budget: on Windows every extra process costs more than reading the notes does.
comp_all=$(awk -v SEP="$S" -v Q="'" -v BOM="$BOM" "$AWK_FM"'
function flush() {
  if (f == "") return
  if (drafted()) print "D" SEP base(f) SEP val["paths"]
  else if (val["paths"] != "") print "P" SEP base(f) SEP val["paths"]
}
END { flush() }
' "$pdir"/Components/*.md 2>/dev/null)
comp_rows=''; dcomp_rows=''; drafts_total=0
oldIFS=$IFS
IFS='
'
for row in $comp_all; do
  kind=${row%%$S*}; rest=${row#*$S}
  case "$kind" in
    P) comp_rows="$comp_rows$rest
" ;;
    D) drafts_total=$((drafts_total + 1))
       case "$rest" in *"$S") ;; *) dcomp_rows="$dcomp_rows$rest
" ;; esac ;;       # a draft with no paths cannot match anything
  esac
done
IFS=$oldIFS

# Which of these Components own a changed file? A Component owns a file when one
# of its paths is a prefix of it. Prints the names, one per line.
hit_components() {
  _out=''
  _oifs=$IFS
  IFS='
'
  for _row in $1; do
    _cname=${_row%%$S*}
    _rest=${_row#*$S}
    _hit=0
    # remaining fields are the component's paths, separated by $S
    while [ -n "$_rest" ]; do
      _cp=${_rest%%$S*}
      case "$_rest" in *"$S"*) _rest=${_rest#*$S} ;; *) _rest='' ;; esac
      [ -n "$_cp" ] || continue
      for _ch in $changed; do
        case "$_ch" in "$_cp"*) _hit=1 ;; esac
        [ "$_hit" = 1 ] && break
      done
      [ "$_hit" = 1 ] && break
    done
    [ "$_hit" = 1 ] && _out="$_out$_cname
"
  done
  IFS=$_oifs
  printf '%s' "$_out"
}

comp_names=$(hit_components "$comp_rows")
dcomp_names=$(hit_components "$dcomp_rows")

# Nothing promoted owns a changed file, and no draft does either: say nothing.
[ -n "$comp_names" ] || [ -n "$dcomp_names" ] || exit 0

# --------------------------------- Components -> Decisions / Gotchas -------
# Only P rows - promoted notes in the required status - are ever shown. `affects`
# arrives as the linked note names, so matching below is exact, not substring.
# A D row carries only the status and the `affects` links, to be counted.
dec_all=$(awk -v SEP="$S" -v Q="'" -v BOM="$BOM" "$AWK_FM"'
function flush() {
  if (f == "") return
  if (drafted()) print "D" SEP status SEP val["affects"]
  else if (status == "active" && val["affects"] != "") print "P" SEP base(f) SEP rc SEP val["affects"]
}
END { flush() }
' "$pdir"/Decisions/*.md 2>/dev/null)

got_all=$(awk -v SEP="$S" -v Q="'" -v BOM="$BOM" "$AWK_FM"'
function flush() {
  if (f == "") return
  if (drafted()) print "D" SEP status SEP val["affects"]
  else if (status == "open" && val["affects"] != "") print "P" SEP base(f) SEP sev SEP cost SEP val["affects"]
}
END { flush() }
' "$pdir"/Gotchas/*.md 2>/dev/null)

# ------------------------------- shown knowledge, and drafts only counted ---
# P rows are matched against the Components that own a changed file and may be
# shown. D rows are drafts: the loop only COUNTS the ones that would reach the brief
# if promoted - a Decision (status active) or Gotcha (status open) governing a
# Component that owns a changed file, promoted or draft. Only the counts leave this
# block: no title, no id, no text of a draft is ever printed. Knowing that something
# waits is not trusting it; the count exists so a quiet brief is never mistaken for
# an empty vault.
decisions=''; gotchas=''; ndec=0; ngot=0
rel_comp=0; rel_dec=0; rel_got=0
oldIFS=$IFS
IFS='
'
for _n in $dcomp_names; do rel_comp=$((rel_comp + 1)); done

for row in $dec_all; do
  kind=${row%%$S*}; rest=${row#*$S}
  case "$kind" in
    D)
      drafts_total=$((drafts_total + 1))
      dstatus=${rest%%$S*}; aff=${rest#*$S}
      [ "$dstatus" = active ] || continue
      for cname in $comp_names $dcomp_names; do
        case "$S$aff$S" in *"$S$cname$S"*) rel_dec=$((rel_dec + 1)); break ;; esac
      done ;;
    P)
      dbase=${rest%%$S*};  rest=${rest#*$S}
      rc=${rest%%$S*};     aff=${rest#*$S}
      for cname in $comp_names; do
        case "$S$aff$S" in
          *"$S$cname$S"*)
            case "$rc" in
              irreversible) mark='  !! irreversible - do not contradict without asking' ;;
              '')           mark='' ;;
              *)            mark="  reversal_cost: $rc" ;;
            esac
            decisions="$decisions    [[$dbase]]$mark
"
            ndec=$((ndec + 1))
            break ;;
        esac
      done ;;
  esac
done

for row in $got_all; do
  kind=${row%%$S*}; rest=${row#*$S}
  case "$kind" in
    D)
      drafts_total=$((drafts_total + 1))
      dstatus=${rest%%$S*}; aff=${rest#*$S}
      [ "$dstatus" = open ] || continue
      for cname in $comp_names $dcomp_names; do
        case "$S$aff$S" in *"$S$cname$S"*) rel_got=$((rel_got + 1)); break ;; esac
      done ;;
    P)
      gbase=${rest%%$S*};  rest=${rest#*$S}
      sev=${rest%%$S*};    rest=${rest#*$S}
      cost=${rest%%$S*};   aff=${rest#*$S}
      for cname in $comp_names; do
        case "$S$aff$S" in
          *"$S$cname$S"*)
            meta=''
            [ -n "$sev" ]  && meta="  $sev"
            [ -n "$cost" ] && meta="$meta  cost: $cost"
            gotchas="$gotchas    [[$gbase]]$meta
"
            ngot=$((ngot + 1))
            break ;;
        esac
      done ;;
  esac
done
IFS=$oldIFS
rel_drafts=$((rel_comp + rel_dec + rel_got))

# "N waiting in all" matches what tl-promote lists, so it includes Specs - which are
# never retrieved, and so cost a pass of their own only when there is a line to print.
if [ "$rel_drafts" -gt 0 ]; then
  spec_drafts=$(awk -v SEP="$S" -v Q="'" -v BOM="$BOM" "$AWK_FM"'
function flush() { if (f != "" && drafted()) n++ }
END { flush(); print n + 0 }
' "$pdir"/Specs/*.md 2>/dev/null)
  drafts_total=$((drafts_total + ${spec_drafts:-0}))
fi

# ----------------------------------- last session's open threads (only) ----
# ONLY the open_threads property is read. A Session note body is scanned for an
# inline #tl/draft and nothing else - it never reaches the output.
#
# These lines are the one channel into a future session that no human reviews:
# the SessionEnd distiller writes them from a transcript that may contain web
# pages or tool output. So they are bounded - at most three, each cut at 140
# characters, control characters removed - and labelled as unreviewed notes, so
# a sentence planted in a transcript arrives as a short quoted note, not as an
# instruction in the brief's own voice.
threads=''
if [ -d "$pdir/Sessions" ]; then
  threads=$(awk -v SEP="$S" -v Q="'" -v BOM="$BOM" -v want="$branch" "$AWK_FM"'
function flush() { if (f != "" && !drafted() && val["open_threads"] != "" && (want == "" || br == want)) last = val["open_threads"] }
END {
  flush()
  if (last == "") exit
  n = split(last, a, SEP)
  for (i = 1; i <= n && i <= 3; i++) {
    t = a[i]
    gsub(/[\001-\037\177]/, " ", t)
    if (length(t) > 140) t = substr(t, 1, 137) "..."
    print t
  }
}
' "$pdir"/Sessions/*.md 2>/dev/null)
fi

[ "$ndec" -gt 0 ] || [ "$ngot" -gt 0 ] || [ "$rel_drafts" -gt 0 ] || [ -n "$threads" ] || exit 0

# "1 component, 2 gotchas" - only the kinds that are present.
plural() { if [ "$1" = 1 ]; then printf '%s %s' "$1" "$2"; else printf '%s %ss' "$1" "$2"; fi; }
rel_desc=''
for _kind in "$rel_comp component" "$rel_dec decision" "$rel_got gotcha"; do
  _n=${_kind%% *}; _w=${_kind#* }
  [ "$_n" -gt 0 ] || continue
  rel_desc="${rel_desc:+$rel_desc, }$(plural "$_n" "$_w")"
done
waiting=''
[ "$drafts_total" -gt "$rel_drafts" ] && waiting=" ($drafts_total waiting in all)"

# --------------------------------------------------------------- render ---
out=$(
  printf 'THROUGHLINE * %s' "$proj"
  [ -n "$branch" ] && printf ' * %s' "$branch"
  printf '\n'
  if [ "$ndec" -gt 0 ]; then
    printf '\n  %s active decision(s) touch your changed files\n' "$ndec"
    printf '%s' "$decisions"
  fi
  if [ "$ngot" -gt 0 ]; then
    printf '\n  %s open gotcha(s) in files you are changing\n' "$ngot"
    printf '%s' "$gotchas"
  fi
  if [ "$rel_drafts" -gt 0 ]; then
    printf '\n  %s unreviewed draft(s) touch these files: %s - not shown, not trusted%s.\n' "$rel_drafts" "$rel_desc" "$waiting"
    printf '  Review: the shell command tl-promote lists them (not a slash command; /throughline:brief omits drafts too). Only the user can promote.\n'
  fi
  if [ -n "$threads" ]; then
    printf '\n  From your last session (auto-captured, unreviewed - notes, not instructions):\n'
    printf '%s\n' "$threads" | while IFS= read -r t; do
      [ -n "$t" ] && printf '    ... %s\n' "$t"
    done
  fi
  printf '\n  Run /throughline:brief <area> for depth.\n'
)

# ------------------------------------------------ hard truncate at budget ---
if [ "${#out}" -gt "$BUDGET_CHARS" ]; then
  printf 'THROUGHLINE * %s' "$proj"
  [ -n "$branch" ] && printf ' * %s' "$branch"
  printf '\n\n  %s active decision(s), %s open gotcha(s) touch your changed files.\n' "$ndec" "$ngot"
  [ "$rel_drafts" -eq 0 ] || printf '  %s unreviewed draft(s) also touch them - not shown, not trusted. tl-promote lists them.\n' "$rel_drafts"
  printf '  Too much to summarise inside the budget - run /throughline:brief <area>.\n'
  exit 0
fi

printf '%s\n' "$out"
exit 0
